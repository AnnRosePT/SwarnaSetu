# Copy this file to .env and fill in only what you need.
# With nothing set, SwarnaSetu runs fully in demo mode (simulator + rule-based extraction).

# Database. Default is a SQLite file in backend/data/. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/swarnasetu
# Set to 0 to start with an empty database instead of demo data.
SEED_DEMO=1

# Speech-to-text for voice notes (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4

# Gemini for extra extraction help and answer phrasing (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Lyzr agent for the ledger Q&A (agent built in Lyzr Agent Studio)
LYZR_API_KEY=
LYZR_AGENT_ID=

# Real WhatsApp (Meta WhatsApp Cloud API). Webhook URL: https://<your-server>/webhook/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=swarnasetu-verify

# How often reminders are checked, in seconds (0 turns the background loop off)
REMINDER_INTERVAL_S=300
# Reconciliation tolerance in milligrams (10 = 0.010 g)
TOLERANCE_MG=10
